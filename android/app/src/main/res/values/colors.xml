<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tint applied by the Android system to the monochrome notification
      small icon (`ic_notification.xml`). Matches the brand primary used
      across the app (Material color system + launcher background).
    -->
    <color name="notification_color">#6366F1</color>
    <!--
      `ic_launcher_background` is deliberately NOT declared here. The adaptive
      icon assets are generated by Android Studio's Image Asset wizard, which
      owns `values/ic_launcher_background.xml`. Declaring the same name in
      both files fails `:app:mergeReleaseResources` with "Duplicate
      resources" — it broke the release APK build once.
    -->
</resources>