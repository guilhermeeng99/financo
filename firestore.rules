rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────
    // Master email is hardcoded in three places that must stay in sync:
    //   - this file
    //   - lib/core/constants/access_control.dart (kMasterEmail)
    //   - functions/src/config.ts (MASTER_EMAIL)
    // A unit test asserts the three are equal.
    function isMaster() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'guilhermeeng99@gmail.com';
    }

    function isAllowed() {
      return request.auth != null && (
        isMaster() ||
        exists(/databases/$(database)/documents/allowed_emails/$(request.auth.token.email.lower()))
      );
    }

    function ownsResource() {
      return resource.data.userId == request.auth.uid;
    }

    function ownsCreate() {
      return request.resource.data.userId == request.auth.uid;
    }

    // ─── Users ──────────────────────────────────────────────
    match /users/{userId} {
      allow read, update, delete: if (isAllowed() && request.auth.uid == userId)
        || isMaster();
      allow create: if (isAllowed() && request.auth.uid == userId)
        || isMaster();

      // FCM push tokens (one doc per device, doc id == token).
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if (isAllowed() && request.auth.uid == userId)
          || isMaster();
      }
    }

    // ─── Allowlist ─────────────────────────────────────────
    // Only master may list or mutate the allowlist. A signed-in user may
    // `get` ONLY their own email doc: the client sign-in gate
    // (AuthRepositoryImpl._gate) reads allowed_emails/{selfEmail} directly,
    // and the gate fails open on errors — so a blanket deny here would
    // silently disable the allowlist for every non-master user.
    match /allowed_emails/{email} {
      allow get: if isMaster()
        || (request.auth != null
            && request.auth.token.email != null
            && request.auth.token.email.lower() == email);
      allow list: if isMaster();
      allow create, update, delete: if isMaster();
    }

    // ─── Accounts ───────────────────────────────────────────
    match /accounts/{accountId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Transactions ───────────────────────────────────────
    match /transactions/{transactionId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Categories ─────────────────────────────────────────
    match /categories/{categoryId} {
      // Default categories (userId == null) are readable by all allowed users.
      allow read: if isAllowed();
      allow create: if isAllowed() && ownsCreate();
      allow update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Chat Messages ─────────────────────────────────────
    match /chat_messages/{messageId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Bills ──────────────────────────────────────────────
    match /bills/{billId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Budgets ────────────────────────────────────────────
    match /budgets/{budgetId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Asset Classes (Investments) ───────────────────────
    // User-defined buckets used by the investments tracking layer.
    // See docs/specs/investments.md.
    match /asset_classes/{assetClassId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Asset Holdings (legacy V1 — superseded by investment_* in F7) ──
    // The app no longer reads or writes this collection; the V2 investing
    // module (institutions/investment_assets/investment_transactions) replaced
    // it. Rule retained read-only for rollback + account-wipe cleanup, mirroring
    // the bills legacy convention.
    match /asset_holdings/{assetHoldingId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Investing V2: Institutions ────────────────────────
    // Custody institutions (Nubank, Avenue, …). See docs/specs/investing.md.
    match /institutions/{institutionId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Investing V2: Assets ──────────────────────────────
    match /investment_assets/{assetId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Investing V2: Transactions ────────────────────────
    // Buy/sell/dividend events (source of truth for holdings).
    match /investment_transactions/{investmentTransactionId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }

    // ─── Investing V2: Net-worth snapshots ─────────────────
    // Daily net-worth history, doc id = "${userId}_${yyyy-MM-dd}" and written
    // via set() (create or overwrite). See docs/specs/valuation.md.
    match /investment_snapshots/{snapshotId} {
      allow create: if isAllowed() && ownsCreate();
      allow read, update, delete: if (isAllowed() && ownsResource())
        || isMaster();
    }
  }
}
